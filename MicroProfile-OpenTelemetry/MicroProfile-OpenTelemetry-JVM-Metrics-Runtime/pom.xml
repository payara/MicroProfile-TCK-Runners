<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fish.payara.microprofile.telemetry</groupId>
        <artifactId>parent</artifactId>
        <version>1.1-SNAPSHOT</version>
    </parent>

    <artifactId>microprofile-opentelemetry-jvm-metrics-runtime</artifactId>
    <name>MicroProfile-OpenTelemetry-JVM-Metrics</name>

    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-metrics-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>start-payara-server</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipConfig}</skip>
                            <target if="payara.server.managed">
                                <exec executable="${payara.asadmin}">
                                    <arg value="start-domain" />
                                    <arg value="${payara.domain.name}" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prepare-payara-server</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipConfig}</skip>
                            <target unless="payara.micro.managed">
                                <exec executable="${payara.asadmin}">
                                    <arg value="create-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="mptelemetry.tck.log.file.path=${payara.home}${file.separator}glassfish${file.separator}domains${file.separator}${payara.domain.name}${file.separator}logs${file.separator}server.log" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="create-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.sdk.disabled=false" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="create-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.metrics.exporter=logging" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="create-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.traces.exporter=none" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="create-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.logs.exporter=none" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="create-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.metric.export.interval=3000" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stop-managed-payara-server</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipConfig}</skip>
                            <target if="payara.server.managed">
                                <exec executable="${payara.asadmin}">
                                    <arg value="stop-domain" />
                                    <arg value="${payara.domain.name}" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>restart-remote-payara-server</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipConfig}</skip>
                            <target if="payara.server.remote">
                                <exec executable="${payara.asadmin}">
                                    <arg value="restart-domain" />
                                    <arg value="${payara.domain.name}" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cleanup-remote-payara-server</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTestConfigCleanup}</skip>
                            <target if="payara.server.remote">
                                <exec executable="${payara.asadmin}">
                                    <arg value="delete-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="mptelemetry.tck.log.file.path" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="delete-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.sdk.disabled" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="delete-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.metrics.exporter" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="delete-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.traces.exporter" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="delete-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.logs.exporter" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="delete-system-property" />
                                    <arg value="--target" />
                                    <arg value="server" />
                                    <arg value="otel.metric.export.interval" />
                                </exec>
                                <exec executable="${payara.asadmin}">
                                    <arg value="restart-domain" />
                                    <arg value="${payara.domain.name}" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>